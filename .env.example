# Application settings
APP_NAME=U-Finder Backend
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# Server Settings
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
RELOAD=true

# CORS Settings
CORS_ORIGINS=*
CORS_CREDENTIALS=true
CORS_METHODS=*
CORS_HEADERS=*

# Logging Settings
LOG_LEVEL=INFO
LOG_DIR=logs

# Database Settings (if needed)
DATABASE_URL=postgresql+psycopg://postgres:123456@localhost:5432/u_finder

# API Keys & Secrets (if needed)
SECRET_KEY=your-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Email Settings
# For Gmail, use: smtp.gmail.com (port 587 with TLS)
# For Outlook/Hotmail, use: smtp-mail.outlook.com (port 587 with TLS)
# For custom SMTP server, configure accordingly
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=U-Finder
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Additional configuration
WORKERS=4
