# Application settings
APP_NAME=U-Finder Backend
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# Server Settings
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
RELOAD=true

# CORS Settings
CORS_ORIGINS=*
CORS_CREDENTIALS=true
CORS_METHODS=*
CORS_HEADERS=*

# Logging Settings
LOG_LEVEL=INFO
LOG_DIR=logs

# Database Settings
DATABASE_URL=postgresql+psycopg://postgres:123456@localhost:5432/u_finder
DATABASE_ECHO=false

# API Keys & Secrets
SECRET_KEY=your-super-secret-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Email Settings
# === Local Development (recommended for quick testing) ===
# Use MailHog for local email testing (download: https://github.com/mailhog/MailHog/releases)
# Run MailHog: MailHog.exe
# Web UI: http://127.0.0.1:8025
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=test@ufinder.com
SMTP_FROM_NAME=U-Finder
SMTP_USE_TLS=false
SMTP_USE_SSL=false

# === Production Email Services ===
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USE_TLS=true
# For Outlook: SMTP_HOST=smtp-mail.outlook.com, SMTP_PORT=587, SMTP_USE_TLS=true
# For AWS SES, SendGrid, etc.: Refer to their documentation

# Redis Settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Dify Settings
DIFY_API_BASE_URL=https://api.dify.ai/v1
DIFY_API_KEY=app-your-dify-api-key-here
DIFY_WORKFLOW_API_KEY=app-your-dify-workflow-api-key-here
DIFY_TIMEOUT=60

# 2FA / TOTP Settings
# Generate with: python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
TOTP_ENCRYPTION_KEY=your-base64-encoded-32-byte-key-here

# CV Upload Settings
CV_MAX_FILE_SIZE=10485760

# Additional configuration
WORKERS=4
