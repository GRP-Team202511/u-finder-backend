# ============================================================
# U-Finder Backend — Production Environment Variables
# Copy to .env on the server and fill in real values
# ============================================================

# --- Application ---
APP_NAME=U-Finder Backend
APP_VERSION=0.1.0
ENVIRONMENT=production
DEBUG=false

# --- Server ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
RELOAD=false
WORKERS=2

# --- CORS (set to your actual frontend domain) ---
CORS_ORIGINS=https://your-frontend-domain.com
CORS_CREDENTIALS=true
CORS_METHODS=*
CORS_HEADERS=*

# --- Logging ---
LOG_LEVEL=INFO
LOG_DIR=logs

# --- PostgreSQL (Docker internal) ---
POSTGRES_USER=u_finder_prod
POSTGRES_PASSWORD=<GENERATE_STRONG_PASSWORD>
POSTGRES_DB=u_finder
POSTGRES_PORT=5432

# DATABASE_URL is auto-composed in docker-compose.yml; keep this as fallback
DATABASE_URL=postgresql+asyncpg://u_finder_prod:<SAME_PASSWORD>@postgres:5432/u_finder

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=<GENERATE_STRONG_PASSWORD>

# --- Secrets ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=<GENERATE_SECRET_KEY>
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Email (SMTP) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=<EMAIL_APP_PASSWORD>
SMTP_FROM_EMAIL=noreply@your-domain.com
SMTP_FROM_NAME=U-Finder
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# --- Dify ---
DIFY_API_BASE_URL=https://api.dify.ai/v1
DIFY_API_KEY=app-xxx
DIFY_WORKFLOW_API_KEY=app-xxx
DIFY_TIMEOUT=60

# --- 2FA / TOTP ---
# Generate with: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
TOTP_ENCRYPTION_KEY=<GENERATE_BASE64_KEY>

# --- Cloudflare Turnstile ---
# Get keys from: https://dash.cloudflare.com → Turnstile (Managed mode)
TURNSTILE_SECRET_KEY=<YOUR_TURNSTILE_SECRET_KEY>
TURNSTILE_ENABLED=true

# --- WebAuthn / Passkey ---
WEBAUTHN_RP_ID=your-domain.com
WEBAUTHN_RP_NAME=U-Finder
WEBAUTHN_ORIGIN=https://your-frontend-domain.com

# --- Upload ---
CV_MAX_FILE_SIZE=10485760
AVATAR_UPLOAD_DIR=uploads/avatars
